{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LMS Video Explorer",
  "version": "0.1.6",
  "identifier": "com.lucas.lms-explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LMS Video Explorer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Lucas Marques",
    "copyright": "Copyright (c) 2026 Lucas Marques da Silva",
    "shortDescription": "Gerenciador e explorador de vídeos de alta performance",
    "longDescription": "LMS Video Explorer é um aplicativo desktop moderno para catalogação e gerenciamento de acervos de vídeo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": ["Portuguese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
